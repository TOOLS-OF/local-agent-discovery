{
  "$schema":"http://json-schema.org/draft-07/schema#",
  "title":"Git workspace restoration request",
  "description":"Planning contract. No checkout, clone, fetch, branch switch or worktree mutation is executed by validation.",
  "type":"object","additionalProperties":false,
  "required":["version","inventoryRef","acquisition","checkout","destination","localState","dependencies","executionReady"],
  "properties":{
    "version":{"const":1},"inventoryRef":{"type":"string","minLength":1},"executionReady":{"const":false},
    "acquisition":{
      "type":"object","additionalProperties":false,"required":["method","remoteUrl","networkPolicy","objectIndependence"],
      "properties":{
        "method":{"enum":["preserved-repository-copy","local-clone","bundle","remote-clone","existing-destination-repository"]},
        "remoteUrl":{"type":["string","null"],"minLength":1},
        "networkPolicy":{"enum":["offline","explicit-fetch"]},
        "objectIndependence":{"const":"no-source-alternates-or-hardlink-dependency"}
      },
      "allOf":[{"if":{"properties":{"method":{"const":"remote-clone"}}},"then":{"properties":{"remoteUrl":{"type":"string","minLength":1},"networkPolicy":{"const":"explicit-fetch"}}}}]
    },
    "checkout":{
      "type":"object","additionalProperties":false,"required":["baseline","commit","branchPolicy","branchName","remoteDrift"],
      "properties":{
        "baseline":{"enum":["source-inventory-head","agent-recorded-commit","explicit-commit","observed-remote-tip"]},
        "commit":{"type":"string","pattern":"^[a-fA-F0-9]{40}([a-fA-F0-9]{24})?$"},
        "branchPolicy":{"enum":["same-name-in-independent-repository","new-contributor-branch","existing-destination-branch","detached"]},
        "branchName":{"type":["string","null"],"minLength":1},
        "remoteDrift":{"enum":["forbid-head-drift","accept-recorded-diff"]}
      },
      "allOf":[
        {"if":{"properties":{"baseline":{"const":"observed-remote-tip"}}},"then":{"properties":{"remoteDrift":{"const":"accept-recorded-diff"}}}},
        {"if":{"properties":{"branchPolicy":{"const":"detached"}}},"then":{"properties":{"branchName":{"type":"null"}}},"else":{"properties":{"branchName":{"type":"string","minLength":1}}}}
      ]
    },
    "destination":{
      "type":"object","additionalProperties":false,"required":["layout","pathPolicy","path","commonRepository","collisionPolicy"],
      "properties":{
        "layout":{"enum":["standalone-checkout","new-worktree","existing-worktree"]},
        "pathPolicy":{"enum":["original-path-replica","remapped","portal-to-replica"]},
        "path":{"type":"string","minLength":1},"commonRepository":{"type":["string","null"],"minLength":1},
        "collisionPolicy":{"const":"block-without-overwrite"}
      },
      "allOf":[{"if":{"properties":{"layout":{"enum":["new-worktree","existing-worktree"]}}},"then":{"properties":{"commonRepository":{"type":"string","minLength":1}}}}]
    },
    "localState":{
      "type":"object","additionalProperties":false,"required":["preservationRef","application","include"],
      "properties":{
        "preservationRef":{"type":"string","minLength":1},
        "application":{"enum":["restore-exact","reconcile-overlay","clean-with-preserved-local-state"]},
        "include":{"type":"array","uniqueItems":true,"items":{"enum":["staged","unstaged","untracked","ignored-assets","unpublished-refs","stashes","reflogs","git-config","worktree-metadata"]}}
      }
    },
    "dependencies":{
      "type":"object","additionalProperties":false,"required":["submodules","lfs","hooks","absolutePointers"],
      "properties":{
        "submodules":{"enum":["preserve-recorded-commits","explicitly-deferred"]},
        "lfs":{"enum":["preserve-required-objects","explicitly-deferred"]},
        "hooks":{"const":"inventory-before-individual-activation"},
        "absolutePointers":{"const":"record-before-repair-copies-only"}
      }
    }
  },
  "allOf":[
    {"if":{"properties":{"destination":{"properties":{"layout":{"enum":["new-worktree","existing-worktree"]}}}}},"then":{"properties":{"checkout":{"properties":{"branchPolicy":{"enum":["new-contributor-branch","existing-destination-branch","detached"]}}}}}},
    {"if":{"properties":{"checkout":{"properties":{"baseline":{"const":"observed-remote-tip"}}}}},"then":{"properties":{"acquisition":{"properties":{"networkPolicy":{"const":"explicit-fetch"}}}}}}
  ]
}
